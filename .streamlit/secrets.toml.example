# Copy to .streamlit/secrets.toml for local use, or paste into Streamlit Cloud -> App -> Settings -> Secrets.
# NEVER commit the real file (it is in .gitignore).
APP_PASSWORD = "choose-a-long-password"
ODDS_API_KEY = "your-odds-api-key"            # optional: adds DraftKings / BetMGM / theScore Bet
GITHUB_TOKEN = "github_pat_..."               # fine-grained token: this repo only, Contents = Read and write
GH_REPO = "your-github-username/parlays"      # owner/name of your PRIVATE repo
# GH_DATA_BRANCH = "ledger-data"              # optional: branch that stores the ledger (created automatically)
